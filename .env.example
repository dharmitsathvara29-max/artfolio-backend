# ArtFolio Server Configuration
# Note: On macOS, change to 5001 if port 5000 is used by AirPlay Receiver
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or Atlas)
MONGO_URI=mongodb://localhost:27017/artfolio

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# Firebase Admin SDK Configuration
# Option 1: Place serviceAccountKey.json in the project root
# Option 2: Provide full JSON string in production (e.g., Render)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=artfolio-backend.appspot.com

# Client / CORS Origin (Optional)
CLIENT_URL=http://localhost:3000
