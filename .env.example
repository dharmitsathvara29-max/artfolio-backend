# ArtFolio Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/artfolio?retryWrites=true&w=majority

# JWT Secret for Authentication (Use a strong 32+ char random string)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Supabase Project URL → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Service Role Key (has full access - KEEP SECRET)
# Settings → API → Project API Keys → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket name (must match bucket you created in Supabase dashboard)
SUPABASE_STORAGE_BUCKET=artfolio
# ─────────────────────────────────────────────────────────────────────────────

# Client / CORS Origin (Optional)
CLIENT_URL=http://localhost:3000
